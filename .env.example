# ==============================================================================
# Board Game Host & Rules Assistant - Environment Configuration Example
# Copy this file to .env and fill in your GCP environment values.
# ==============================================================================

# Google Cloud Project Settings
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1

# Deployed Agent Engine Endpoint (Cloud Run / Vertex AI Agent Engine)
AGENT_ENGINE_RESOURCE_NAME=https://your-agent-cloud-run-url.run.app
AGENT_DIRECTORY=app

# Public Cloud Storage Bucket for Generated Media & Artworks
GCS_BUCKET_NAME=your-public-media-bucket-name

# Server Port
PORT=8080
